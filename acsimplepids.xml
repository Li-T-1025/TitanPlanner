<?xml version="1.0" encoding="utf-8"?>

<simple>
  <ac>
    <version>3.0</version>

    <param>
      <title>遥控手感 横滚/俯仰</title>
      <desc>向左滑动使遥控输入响应更柔和，向右滑动使响应更灵敏。</desc>
      <name>RC_FEEL_RP</name>
      <value>100</value>
      <min>0</min>
      <max>100</max>
    </param>

    <param>
      <title>横滚/俯仰灵敏度：</title>
      <desc>飞行器反应迟钝时向右滑动，反应过于灵敏时向左滑动。</desc>
      <name>RATE_RLL_P</name>
      <value>0.15</value>
      <min>0.08</min>
      <max>0.4</max>
      <relation>
        <param>RATE_RLL_I</param>
        <multiplier>1</multiplier>
      </relation>
      <relation>
        <param>RATE_PIT_P</param>
        <multiplier>1</multiplier>
      </relation>
      <relation>
        <param>RATE_PIT_I</param>
        <multiplier>1</multiplier>
      </relation>
    </param>

    <param>
      <title>横滚/俯仰灵敏度：</title>
      <desc>飞行器反应迟钝时向右滑动，反应过于灵敏时向左滑动。</desc>
      <name>ATC_RAT_RLL_P</name>
      <value>0.15</value>
      <min>0.08</min>
      <max>0.4</max>
      <relation>
        <param>ATC_RAT_RLL_I</param>
        <multiplier>1</multiplier>
      </relation>
      <relation>
        <param>ATC_RAT_PIT_P</param>
        <multiplier>1</multiplier>
      </relation>
      <relation>
        <param>ATC_RAT_PIT_I</param>
        <multiplier>1</multiplier>
      </relation>
    </param>

    <param>
      <title>悬停油门：</title>
      <desc> 维持稳定悬停所需的油门量。 </desc>
      <name>THR_MID</name>
      <value>480</value>
      <min>200</min>
      <max>800</max>
    </param>

    <param>
      <title>爬升灵敏度：</title>
      <desc>向右滑动使爬升更迅猛，向左滑动使爬升更平缓。</desc>
      <name>THR_ACCEL_P</name>
      <value>0.75</value>
      <min>0.3</min>
      <max>1</max>
      <relation>
        <param>THR_ACCEL_I</param>
        <multiplier>2</multiplier>
      </relation>
    </param>

    <param>
      <title>爬升灵敏度：</title>
      <desc>向右滑动使爬升更迅猛，向左滑动使爬升更平缓。</desc>
      <name>ACCEL_Z_P</name>
      <value>0.75</value>
      <min>0.3</min>
      <max>1</max>
      <relation>
        <param>ACCEL_Z_I</param>
        <multiplier>2</multiplier>
      </relation>
    </param>

  </ac>
</simple>