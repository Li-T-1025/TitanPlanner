<?xml version="1.0" encoding="utf-8"?>
<ArrayOfCheckListItem xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <CheckListItem>
    <TrueColor>Green</TrueColor>
    <FalseColor>Red</FalseColor>
    <Description>校验 GPS</Description>
    <Text>{value} &gt;= 3</Text>
    <TriggerValue>3</TriggerValue>
    <Name>gpsstatus</Name>
    <ConditionType>GTEQ</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>Green</TrueColor>
    <FalseColor>Red</FalseColor>
    <Description>GPS 卫星数</Description>
    <Text>{value} 颗卫星</Text>
    <TriggerValue>5</TriggerValue>
    <Name>satcount</Name>
    <ConditionType>GTEQ</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>Green</TrueColor>
    <FalseColor>Red</FalseColor>
    <Description>遥测信号</Description>
    <Text>{value}%</Text>
    <TriggerValue>95</TriggerValue>
    <Name>linkqualitygcs</Name>
    <ConditionType>GT</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>Green</TrueColor>
    <FalseColor>Red</FalseColor>
    <Description>电池电压</Description>
    <Text>{value} 伏</Text>
    <TriggerValue>22</TriggerValue>
    <Name>battery_voltage</Name>
    <ConditionType>GT</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>模式</Description>
    <Text>{value}</Text>
    <TriggerValue>0</TriggerValue>
    <Name>mode</Name>
    <ConditionType>NONE</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>检查高度</Description>
    <Text>{value} &lt; 5 米</Text>
    <TriggerValue>5</TriggerValue>
    <Name>alt</Name>
    <ConditionType>LT</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>机尾与机翼已固定？</Description>
    <Text />
    <TriggerValue>0</TriggerValue>
    <Name>roll</Name>
    <ConditionType>NONE</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>所有舵机响应输入？</Description>
    <Text />
    <TriggerValue>0</TriggerValue>
    <Name>roll</Name>
    <ConditionType>NONE</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>所有舵机响应俯仰和横滚？</Description>
    <Text />
    <TriggerValue>0</TriggerValue>
    <Name>roll</Name>
    <ConditionType>NONE</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>重心位于指定点？</Description>
    <Text />
    <TriggerValue>0</TriggerValue>
    <Name>roll</Name>
    <ConditionType>NONE</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>舵机连杆已紧固？</Description>
    <Text />
    <TriggerValue>0</TriggerValue>
    <Name>roll</Name>
    <ConditionType>NONE</ConditionType>
  </CheckListItem>
  <CheckListItem>
    <TrueColor>White</TrueColor>
    <FalseColor>White</FalseColor>
    <Description>相机已开启并可飞行？</Description>
    <Text />
    <TriggerValue>0</TriggerValue>
    <Name>roll</Name>
    <ConditionType>NONE</ConditionType>
  </CheckListItem>
</ArrayOfCheckListItem>
